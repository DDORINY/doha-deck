generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ProjectVisibility {
  PUBLIC
  PRIVATE
}

model Admin {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Project {
  id              String            @id @default(uuid())
  title           String
  slug            String            @unique
  summary         String
  description     String
  thumbnailUrl    String?
  githubUrl       String?
  deployUrl       String?
  deckUrl         String?
  readmeUrl       String?
  visibility      ProjectVisibility @default(PRIVATE)

  features        String?
  architecture    String?
  troubleshooting String?
  retrospective   String?

  stacks          ProjectStack[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ProjectStack {
  id        String  @id @default(uuid())
  projectId String
  name      String
  category  String?

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}